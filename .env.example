# ==========================================
# DISCORD
# ==========================================

DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN


# ==========================================
# DEFAULT AI PROVIDER
# ==========================================

DEFAULT_PROVIDER=openrouter


# ==========================================
# OPENROUTER
# Models run from left to right
# ==========================================

OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY
OPENROUTER_MODELS=google/gemma-3-27b-it:free,openrouter/free


# ==========================================
# OPTIONAL DIRECT AI PROVIDERS
# Leave blank if only using OpenRouter
# ==========================================

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=


# ==========================================
# OPTIONAL DIRECT-PROVIDER MODELS
# ==========================================

GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-large-latest
COHERE_MODEL=command-a


# ==========================================
# LOCAL AI
# ==========================================

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen3-4b


# ==========================================
# MEDIA SERVICES
# ==========================================

YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ==========================================
# OPTIONAL TOOLS
# ==========================================

GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
NEWS_API_KEY=


# ==========================================
# DATABASE AND MEMORY
# ==========================================

DATABASE_NAME=data/nexus.db
MEMORY_LIMIT=20


# ==========================================
# LOGGING
# ==========================================

DEBUG=true
LOG_LEVEL=INFO