# ==========================================
# DISCORD
# ==========================================

DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN
COMMAND_GUILD_ID=
CREATOR_ID=1169870987135823876
NEXUS_NICKNAME=Nexy


# ==========================================
# DEFAULT AI PROVIDER
# ==========================================

DEFAULT_PROVIDER=openrouter


# ==========================================
# OPENROUTER
# Models run from left to right
# ==========================================

OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY
OPENROUTER_MODELS=google/gemma-3-27b-it:free,openrouter/free


# ==========================================
# OPTIONAL DIRECT AI PROVIDERS
# Leave blank if not configured
# ==========================================

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=


# ==========================================
# OPTIONAL DIRECT-PROVIDER MODELS
# ==========================================

GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-large-latest
COHERE_MODEL=command-a


# ==========================================
# LOCAL AI
# ==========================================

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen3-4b


# ==========================================
# MEDIA SERVICES
# ==========================================

YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ==========================================
# MUSIC PLAYBACK (LAVALINK V4)
# ==========================================

MUSIC_ENABLED=true
LAVALINK_URI=https://YOUR-LAVALINK-HOST
LAVALINK_PASSWORD=PASTE_YOUR_LAVALINK_PASSWORD
LAVALINK_IDENTIFIER=nexus-main
LAVALINK_INACTIVE_TIMEOUT=300
MUSIC_DEFAULT_VOLUME=75
MUSIC_MAX_QUEUE=250
MUSIC_DJ_ROLE=DJ
MUSIC_ANNOUNCE_TRACKS=true


# ==========================================
# LIVE VOICE WITH NEXY (GROQ STT + TTS)
# Uses GROQ_API_KEY from the provider section above.
# ==========================================

VOICE_CHAT_ENABLED=true
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_TTS_MODEL=canopylabs/orpheus-v1-english
VOICE_TTS_VOICE=hannah
VOICE_TTS_SPEED=1.0
# Blank means automatic language detection.
VOICE_LANGUAGE=
VOICE_SILENCE_SECONDS=0.9
VOICE_MIN_UTTERANCE_SECONDS=0.5
VOICE_MAX_UTTERANCE_SECONDS=20
# Groq Orpheus has a 200-character maximum; 190 leaves punctuation room.
VOICE_MAX_REPLY_CHARS=190
# Post each transcribed turn and answer in the command channel.
VOICE_TRANSCRIPTS=true
# Optional override; bundled imageio-ffmpeg is used when this is blank.
FFMPEG_PATH=


# ==========================================
# OPTIONAL SEARCH AND TOOL SERVICES
# ==========================================

BRAVE_API_KEY=
GITHUB_TOKEN=
# Reddit Data API approval is required. The tool stays disabled until all
# three approved OAuth values are configured.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ProjectNexus/2.0 by u/YOUR_REDDIT_USERNAME
NEWS_API_KEY=
GNEWS_API_KEY=
# Optional self-hosted server. Leave blank to use the free MyMemory fallback.
LIBRETRANSLATE_URL=
# Extra RSS/Atom sources: Name|https://feed.url,Another|https://feed.url
NEWS_FEEDS=


# ==========================================
# ACCURACY PIPELINE
# ==========================================

# auto = decide per question, always = search every prompt, never = chat only.
SEARCH_MODE=auto

# SEARCH_TIMEOUT is canonical; AI_REQUEST_TIMEOUT remains compatible.
SEARCH_TIMEOUT=18
AI_REQUEST_TIMEOUT=18

MAX_SOURCES=6
MIN_SOURCES_FOR_GROUNDING=2
MAX_CONTEXT_SOURCES=5
EVIDENCE_CHAR_BUDGET=9000

VERIFICATION_ENABLED=true
AUTO_RETRY_WITH_SEARCH=true
REFUSE_WHEN_UNVERIFIED=true
CACHE_FRESHNESS_AWARE=true

# auto | footer | inline | off
CITATION_MODE=auto

OPENROUTER_WEB_SEARCH=true
OPENROUTER_SEARCH_RESULTS=5


# ==========================================
# SELF-UPDATE AND KNOWLEDGE
# ==========================================

SELF_UPDATE_ENABLED=true
SELF_UPDATE_INTERVAL=21600
KNOWLEDGE_TTL=86400
KNOWLEDGE_MAX_ENTRIES=2000
KNOWLEDGE_MIN_CONFIDENCE=0.35
TOOL_PROBE_INTERVAL=1800
MODEL_AUTO_REFRESH=true
WATCHLIST_LIMIT=12
RUNTIME_FACTS_INTERVAL=300


# ==========================================
# DATABASE AND MEMORY
# ==========================================

DATABASE_NAME=data/nexus.db
MEMORY_LIMIT=20
MEMORY_LLM_EXTRACTION=false
FACT_REVIEW_INTERVAL=2592000


# ==========================================
# LOCAL FILE ACCESS
# ==========================================

FILE_READER_ENABLED=false
FILE_READER_ROOT=data/uploads


# ==========================================
# RENDER HEALTH SERVER
# ==========================================

PORT=10000


# ==========================================
# LOGGING
# ==========================================

DEBUG=true
LOG_LEVEL=INFO
