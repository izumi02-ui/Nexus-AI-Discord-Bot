# ==========================================
# DISCORD
# ==========================================

DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN


# ==========================================
# DEFAULT AI PROVIDER
# ==========================================

DEFAULT_PROVIDER=openrouter


# ==========================================
# OPENROUTER
# Models run from left to right
# ==========================================

OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY
OPENROUTER_MODELS=google/gemma-3-27b-it:free,openrouter/free


# ==========================================
# OPTIONAL DIRECT AI PROVIDERS
# Leave blank if only using OpenRouter
# ==========================================

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=


# ==========================================
# OPTIONAL DIRECT-PROVIDER MODELS
# ==========================================

GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-large-latest
COHERE_MODEL=command-a


# ==========================================
# LOCAL AI
# ==========================================

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen3-4b


# ==========================================
# MEDIA SERVICES
# ==========================================

YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ==========================================
# OPTIONAL TOOLS
# ==========================================

GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
NEWS_API_KEY=


# ==========================================
# ACCURACY PIPELINE
# ==========================================

# auto = decide per question, always = search every prompt, never = chat only.
SEARCH_MODE=auto

# Hard deadline for the whole evidence phase, so one dead API cannot stall a reply.
SEARCH_TIMEOUT=18

# How many sources to collect, and how many independent domains a claim needs
# before Nexus states it as verified fact.
MAX_SOURCES=6
MIN_SOURCES_FOR_GROUNDING=2

# Compare the finished answer with the evidence; re-ask once when it cannot stand.
VERIFICATION_ENABLED=true
AUTO_RETRY_WITH_SEARCH=true

# For "right now" questions, refuse instead of guessing when nothing verified.
REFUSE_WHEN_UNVERIFIED=true

# auto | footer | inline | off - how sources are credited under each answer.
CITATION_MODE=auto

# Use OpenRouter's live web-search server tool for questions that need current
# information. This can consume OpenRouter credits; use false for keyless-only.
OPENROUTER_WEB_SEARCH=true
OPENROUTER_SEARCH_RESULTS=5


# ==========================================
# SELF-UPDATE (Nexus re-checks its own knowledge)
# ==========================================

SELF_UPDATE_ENABLED=true
# How often the background cycle re-verifies stale knowledge, probes tools and
# refreshes runtime facts. 6 hours is a sensible default for a community bot.
SELF_UPDATE_INTERVAL=21600

# How long a verified fact may be quoted before it must be re-checked.
KNOWLEDGE_TTL=86400
KNOWLEDGE_MAX_ENTRIES=2000
KNOWLEDGE_MIN_CONFIDENCE=0.35

# How often each evidence tool is health-checked with a real query.
TOOL_PROBE_INTERVAL=1800

# Re-read provider model lists so a retired model id does not take the bot down.
MODEL_AUTO_REFRESH=true
WATCHLIST_LIMIT=12
RUNTIME_FACTS_INTERVAL=300


# ==========================================
# DATABASE AND MEMORY
# ==========================================

DATABASE_NAME=data/nexus.db
MEMORY_LIMIT=20

# Reading files a user uploads is off by default; when enabled it is confined
# to this directory.
FILE_READER_ENABLED=false
FILE_READER_ROOT=data/uploads


# ==========================================
# DISCORD COMMANDS
# ==========================================

# Optional guild id: slash commands appear instantly in one server while you
# test, instead of waiting for the global cache to clear.
COMMAND_GUILD_ID=


# ==========================================
# LOGGING
# ==========================================

DEBUG=true
LOG_LEVEL=INFO
